# Port Backend Express
PORT=5000

# PostgreSQL Connection String (Neon Database)
# Format Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_example@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Node Environment
NODE_ENV=development

# CORS Allowed Origins
CLIENT_URL=http://localhost:5173
